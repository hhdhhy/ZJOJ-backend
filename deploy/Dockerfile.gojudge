# 基于官方 go-judge 镜像构建包含编译器的版本
FROM criyle/go-judge:latest

USER root

# 安装 C/C++ 编译器和其他常用语言环境
RUN apt-get update && apt-get install -y \
    g++ \
    gcc \
    python3 \
    python3-pip \
    default-jdk \
    && rm -rf /var/lib/apt/lists/*

# 验证安装
RUN g++ --version && gcc --version && python3 --version

# 切换回 go-judge 用户
USER 1536
