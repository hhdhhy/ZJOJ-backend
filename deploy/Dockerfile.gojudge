# 多阶段构建：基于官方 go-judge 镜像
FROM criyle/go-judge:latest AS go-judge

# 第二阶段：基于 Debian 安装编译器
FROM debian:latest

# 更换为阿里云镜像源加速下载
RUN sed -i 's/deb.debian.org/mirrors.aliyun.com/g' /etc/apt/sources.list.d/debian.sources || \
    sed -i 's|http://deb.debian.org|http://mirrors.aliyun.com|g' /etc/apt/sources.list

# 安装 C/C++ 编译器和其他常用语言环境
RUN apt-get update && apt-get install -y \
    g++ \
    gcc \
    python3 \
    python3-pip \
    default-jdk \
    && rm -rf /var/lib/apt/lists/*

# 从第一阶段复制 go-judge 二进制文件和配置文件
WORKDIR /opt
COPY --from=go-judge /opt/go-judge /opt/
COPY --from=go-judge /opt/mount.yaml /opt/

# 暴露端口
EXPOSE 5050/tcp 5051/tcp 5052/tcp

# 设置入口点
ENTRYPOINT ["./go-judge"]
