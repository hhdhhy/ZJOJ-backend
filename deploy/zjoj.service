[Unit]
Description=ZJOJ Django Application
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/ZJOJ
Environment="PATH=/home/ubuntu/ZJOJ/.venv/bin"
ExecStart=/home/ubuntu/ZJOJ/.venv/bin/gunicorn --workers 3 --bind 127.0.0.1:8000 --timeout 120 ZJOJ.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

# 日志
StandardOutput=append:/opt/zjoj_data/logs/gunicorn_stdout.log
StandardError=append:/opt/zjoj_data/logs/gunicorn_stderr.log

# 资源限制
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
